#!/usr/bin/env bash

items=$(
  (
    git status --porcelain --untracked-files 2>/dev/null | grep -E '^.[^ ]' | sort -k 2
  ) | \
  fzf --multi --query "$*" --preview-window down,50% --preview 'f() {
    iw="$(echo $1 | cut -c 1-2)"
    file="$(echo $1 | cut -c 4-)"

    if [ "${iw}" = "??" ]; then
      cd "$(git rev-parse --show-toplevel)"
      git diff --color --no-index -- /dev/null "${file}" | COLUMNS="${FZF_PREVIEW_COLUMNS}" eval "$(git var GIT_PAGER)"
    else
      cd "$(git rev-parse --show-toplevel)"
      git diff --color -- "${file}" | COLUMNS="${FZF_PREVIEW_COLUMNS}" eval "$(git var GIT_PAGER)"
    fi
  }; f {}' | \
  cut -c 4-
)

if [ -z "${items}" ]; then
  exit 0
fi

(
  cd "$(git rev-parse --show-toplevel)"
  echo "${items}" | xargs git add
)
